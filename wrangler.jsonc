// Cloudflare Worker with no code, only static files from public/.
//
// Nothing is built: exactly what is in git ships. Workers Builds runs with
// SKIP_DEPENDENCY_INSTALL=1, so npm code never gets a chance to touch the files.
{
  "$schema": "https://unpkg.com/wrangler@4.133.0/config-schema.json",
  "name": "alcor-signer",
  "compatibility_date": "2026-09-01",
  "assets": { "directory": "./public" },
  "routes": [{ "pattern": "sign.alcor.exchange", "custom_domain": true }],
  // One address only: no *.workers.dev, no version URLs.
  "workers_dev": false,
  "preview_urls": false
}
